crates/desktop/gen/

# Nix / direnv
.direnv/
result
result-*

# Capture harness working state — goldens themselves ARE committed
tools/capture-reference/.cache/
tools/capture-reference/.venv/

# Editor and OS noise
.idea/
.vscode/
*.swp
.DS_Store
